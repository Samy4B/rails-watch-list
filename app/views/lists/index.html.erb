<!-- app/views/lists/index.html.erb -->
<h1>All Lists</h1>


<%= link_to 'Create a new list', new_list_path %>

<% @lists.each do |list| %>
  <div class="list">
    <h2><%= link_to list.name, list_path(list) %></h2>
    <% if list.image.attached? %>
      <%= image_tag list.image, class: "img-thumbnail", size: "200x200" %>
    <% else %>
      <p>No image available</p>
    <% end %>
  </div>
<% end %>
